{
  "name": "cortico-world-postcard",
  "version": "0.1.0",
  "type": "module",
  "description": "桌宠旅行明信片：持久旅行计时、取消、恢复及收藏核心",
  "license": "MIT",
  "keywords": [
    "cortico-world",
    "cortico"
  ],
  "engines": {
